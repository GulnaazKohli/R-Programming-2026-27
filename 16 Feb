install.packages("corrplot")
library(corrplot)

data<- mtcars
p1<-cor(data)
corrplot(p1)
corrplot(p1, method ="number")
corrplot(p1, method ="square", order="alphabet")
#simple regression
model1<- lm(data$mpg~data$wt)
summary(model1)
#regression with two independent va
riables, goodness of fit
model2<- lm(data$mpg~data$wt+data$am)
summary(model2)
#regression through origin, doesn't have intercept value
model3<- lm(data$mpg~data$wt+data$am-1)
summary(model3) 

