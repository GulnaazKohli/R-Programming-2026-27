install.packages("dplyr")
library(dplyr)
x<-c(5,3,9,7,8,2,4)
y<-c(2.5,3.7,1.2,4.5,6.6,8,7)
z<-c('a','b','b','a','a','b','a')
data2<-data.frame(x,y,z)
data2|>filter(z=='a')|> summarise(mean(x))
data3<- data2|>filter(z=='b')
data2 %>% group_by(z) %>% summarise(mean(x))
install.packages("flextable")
library(flextable) 
data2 %>% group_by(z) %>% summarise(mean(x)) %>% flextable()
data2 %>% group_by(z) %>% summarise(mean(x), sd(x), mean(y), sd(y)) %>% flextable()
data2$m<- data2|> mutate(x/y)
data2 |>mutate(m=x/y)
data2 |>group_by (z) |> mutate(m=mean(x))
