# ggplot 2 (grammar of graphics)
#download a package 
install.packages("ggplot2") 
# call a package
library(ggplot2)
x<-1:26
y<-log(x)
today<-data.frame(x,y)
plot(x,y)
#start ggplot2
p1<-ggplot(data=today)
p1<-p1+(mapping=aes(x=x, y=y))
p1<-p1+geom_point()

